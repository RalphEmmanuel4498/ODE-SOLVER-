For convenience, the equations in System~\eqref{eq:model1} are written with all terms on the left-hand side as
\begin{align}
	N_S &= \dot S-\Lambda-\delta R+(\beta_1u_1+\mu)S, \\
	N_E &= \dot E-\beta_1u_1S+(\beta_2+\mu)E, \\
	N_A &= \dot A-\beta_2E+(\beta_3u_2+\alpha+\mu)A, \\
	N_C &= \dot C-(\beta_3u_2+\alpha)A+(\beta_4+\gamma+\mu)C, \\
	N_L &= \dot L-\beta_4C+\mu L, \\
	N_R &= \dot R-\gamma C+(\delta+\mu)R.
	\label{eq:Nops}
\end{align}
Hence, the system can be expressed compactly as
\begin{equation}
	N_i[\mathbf{x}]=0,
	\qquad i\in\{S,E,A,C,L,R\}.
\end{equation}
An initial approximation is taken from the initial value of each compartment:
\begin{equation}
	x_{i,0}(t)=x_i(0),
	\qquad
	\dot{x}_{i,0}(t)=0.
\end{equation}
To continuously deform this approximation into the required solution, an embedding parameter $q\in[0,1]$ and a function $\phi_i(t;q)$ are introduced. The value $q=0$ represents the initial approximation, whereas $q=1$ recovers the solution of the original system.

A non-zero auxiliary parameter $\hbar$, known as the convergence-control parameter, is also introduced. It is not a parameter of the SEACLR model; rather, it controls the convergence of the resulting series solution. With the linear operator
\begin{equation}
	\mathcal{L}[\phi_i]=\frac{d\phi_i}{dt},
\end{equation}
the zero-order deformation equation is
\begin{equation}
	(1-q)\mathcal{L}[\phi_i-x_{i,0}]
	=q\hbar N_i[\boldsymbol{\phi}],
	\qquad
	\phi_i(0;q)=x_i(0).
	\label{eq:zeroth}
\end{equation}
Since $\dot{x}_{i,0}=0$, equation~\eqref{eq:zeroth} reduces to
\begin{equation}
	(1-q)\dot{\phi}_i(t;q)
	=q\hbar N_i[\boldsymbol{\phi}(t;q)].
	\label{eq:zeroth2}
\end{equation}
At $q=0$,
\begin{equation}
	\dot{\phi}_i(t;0)=0,
\end{equation}
and therefore
\begin{equation}
	\phi_i(t;0)=x_{i,0}(t).
\end{equation}
At $q=1$,
\begin{equation}
	0=\hbar N_i[\boldsymbol{\phi}(t;1)].
\end{equation}
Since $\hbar\neq0$,
\begin{equation}
	N_i[\boldsymbol{\phi}(t;1)]=0,
\end{equation}
which is the original SEACLR system. Thus,
\begin{equation}
	\phi_i(t;1)=x_i(t).
\end{equation}
The solution is subsequently developed by expanding $\phi_i(t;q)$ in a power series of $q$, from which the higher-order deformation equations and the approximate solution are obtained.

\medskip
\noindent\textbf{Series substitution in the left-hand side.}
The function $\phi_i(t;q)$ is expressed as a power series in the embedding parameter $q$:
\begin{equation}
	\phi_i(t;q)=\sum_{m=0}^{\infty}x_{i,m}(t)q^m,
	\qquad
	\dot{\phi}_i(t;q)=\sum_{m=0}^{\infty}\dot{x}_{i,m}(t)q^m,
	\qquad i\in\{S,E,A,C,L,R\}.
	\label{eq:Maclaurin}
\end{equation}
The coefficient $x_{i,0}(t)$ is the initial approximation, while the higher-order terms $x_{i,1}(t),x_{i,2}(t),\ldots$ provide successive corrections to this approximation. Since $x_{i,0}(t)=x_i(0)$, its derivative is zero.

Substituting the series for $\dot{\phi}_i(t;q)$ from equation~\eqref{eq:Maclaurin} into the left-hand side of equation~\eqref{eq:zeroth2} gives
\begin{equation}
	(1-q)\dot{\phi}_i(t;q)
	=(1-q)\sum_{m=0}^{\infty}\dot{x}_{i,m}(t)q^m.
\end{equation}

Multiplying out the bracket $(1-q)$ against the series term by term,
\begin{equation}
	(1-q)\sum_{m=0}^{\infty}\dot{x}_{i,m}(t)q^m
	=\sum_{m=0}^{\infty}\dot{x}_{i,m}(t)q^m
	-\sum_{m=0}^{\infty}\dot{x}_{i,m}(t)q^{m+1}.
\end{equation}

For the second sum, the index is shifted by setting $n=m+1$, so that $m=n-1$. As $m$ runs from $0$ to $\infty$, $n$ runs from $1$ to $\infty$, giving
\begin{equation}
	\sum_{m=0}^{\infty}\dot{x}_{i,m}(t)q^{m+1}
	=\sum_{n=1}^{\infty}\dot{x}_{i,n-1}(t)q^n.
\end{equation}
Since $n$ is only a summation label, it may be renamed back to $m$ without changing the value of the sum:
\begin{equation}
	\sum_{m=0}^{\infty}\dot{x}_{i,m}(t)q^{m+1}
	=\sum_{m=1}^{\infty}\dot{x}_{i,m-1}(t)q^m.
\end{equation}

Substituting this reindexed form back into the expansion of $(1-q)\dot{\phi}_i(t;q)$ gives
\begin{equation}
	(1-q)\dot{\phi}_i(t;q)
	=\sum_{m=0}^{\infty}\dot{x}_{i,m}(t)q^m
	-\sum_{m=1}^{\infty}\dot{x}_{i,m-1}(t)q^{m}.
\end{equation}

The first sum runs from $m=0$, while the second sum runs from $m=1$. To compare them term by term, the first sum is split off at its $m=0$ term, leaving the rest of it starting from $m=1$ as well:
\begin{equation}
	\sum_{m=0}^{\infty}\dot{x}_{i,m}(t)q^m
	=\dot{x}_{i,0}(t)\,q^{0}+\sum_{m=1}^{\infty}\dot{x}_{i,m}(t)q^m.
\end{equation}

Since $q^0=1$, this is simply
\begin{equation}
	\sum_{m=0}^{\infty}\dot{x}_{i,m}(t)q^m
	=\dot{x}_{i,0}(t)+\sum_{m=1}^{\infty}\dot{x}_{i,m}(t)q^m.
\end{equation}

Substituting this into the earlier expression,
\begin{equation}
	(1-q)\dot{\phi}_i(t;q)
	=\dot{x}_{i,0}(t)+\sum_{m=1}^{\infty}\dot{x}_{i,m}(t)q^m
	-\sum_{m=1}^{\infty}\dot{x}_{i,m-1}(t)q^{m}.
\end{equation}

Both remaining sums now start at the same index, $m=1$, and carry the same power $q^m$ at every step. The two sums may therefore be combined into a single sum, with the coefficients of $q^m$ subtracted at each $m$:
\begin{equation}
	(1-q)\dot{\phi}_i(t;q)
	=\dot{x}_{i,0}(t)
	+\sum_{m=1}^{\infty}
	\left[\dot{x}_{i,m}(t)-\dot{x}_{i,m-1}(t)\right]q^m.
	\label{eq:LHSexp}
\end{equation}
Because $\dot{x}_{i,0}(t)=0$, the $q^0$ term vanishes and the left-hand side starts at $q^1$. This holds for every compartment $i$.

\medskip
\noindent\textbf{Series substitution for $S(t)$.}
The compartment $S(t)$ in System~\eqref{eq:model1} is replaced by its full power series,
\begin{equation}
	S(t)\;\to\;\sum_{k=0}^{\infty}x_{S,k}(t)q^k,
\end{equation}
and since $S$ is fed by $R$, the series $R(t)\to\sum_{k=0}^{\infty}x_{R,k}(t)q^k$ is used as well. The controls $u_1,u_2$ and all parameters carry no $q$, so they pass through the sums unchanged.

Recall
\begin{equation}
	N_S = \dot S-\Lambda-\delta R+(\beta_1u_1+\mu)S.
\end{equation}

Each term of $N_S$ is replaced one at a time.

\begin{equation}
	\dot S \;\to\; \sum_{k=0}^{\infty}\dot{x}_{S,k}(t)q^k.
\end{equation}

\begin{equation}
	\delta R \;\to\; \sum_{k=0}^{\infty}\delta\,x_{R,k}(t)q^k.
\end{equation}

\begin{equation}
	(\beta_1u_1+\mu)S \;\to\; \sum_{k=0}^{\infty}(\beta_1u_1+\mu)x_{S,k}(t)q^k.
\end{equation}

The term $\Lambda$ has no $q$ attached to it in $N_S$, so it only belongs to the $k=0$ term. This is written using the symbol $\mathbf{1}_{\{k=0\}}$, which equals $1$ when $k=0$ and $0$ for every other $k$:
\begin{equation}
	\Lambda \;\to\; \sum_{k=0}^{\infty}\Lambda\,\mathbf{1}_{\{k=0\}}q^k.
\end{equation}

Adding the four replaced terms together, $N_S$ becomes one single sum over $k$:
\begin{equation}
	N_S \;\to\; \sum_{k=0}^{\infty}
	\Bigl[\dot{x}_{S,k}(t) - \Lambda\,\mathbf{1}_{\{k=0\}} - \delta x_{R,k}(t) + (\beta_1u_1+\mu)x_{S,k}(t)\Bigr]q^k.
\end{equation}

The bracket above is given a short name, $\rho_{S,k}(t)$:
\begin{equation}
	\rho_{S,k}(t) = \dot{x}_{S,k}(t) - \Lambda\,\mathbf{1}_{\{k=0\}} - \delta x_{R,k}(t) + (\beta_1u_1+\mu)x_{S,k}(t).
\end{equation}

So
\begin{equation}
	N_S[\boldsymbol{\phi}(t;q)]=\sum_{k=0}^{\infty}\rho_{S,k}(t)q^k .
\end{equation}

Multiplying both sides by $q\hbar$:
\begin{equation}
	q\hbar N_S[\boldsymbol{\phi}(t;q)]
	=\hbar\sum_{k=0}^{\infty}\rho_{S,k}(t)q^{k+1}.
\end{equation}

Set $m=k+1$, so $k=m-1$. As $k$ goes from $0$ to $\infty$, $m$ goes from $1$ to $\infty$:
\begin{equation}
	q\hbar N_S[\boldsymbol{\phi}(t;q)]
	=\hbar\sum_{m=1}^{\infty}\rho_{S,m-1}(t)q^m.
\end{equation}

This is the right-hand side of equation~\eqref{eq:zeroth2}. It has the same form, a sum over $q^m$ starting at $m=1$, as the left-hand side~\eqref{eq:LHSexp}. Two power series are equal only if the coefficient of $q^m$ matches on both sides, for every $m$. Matching them gives, for $m\geq1$,
\begin{equation}
	\dot{x}_{S,m}(t)-\dot{x}_{S,m-1}(t)=\hbar\rho_{S,m-1}(t).
	\label{eq:S_first_deformation bf}
\end{equation}
At $m=1$, the deformation equation is
\begin{equation}
	\dot{x}_{S,1}(t)-\dot{x}_{S,0}(t)=\hbar\,\rho_{S,0}(t).
	\label{eq:S_first_deformation}
\end{equation}
Since $x_{S,0}(t)=S(0)$, it follows that $\dot{x}_{S,0}(t)=0$. Equation~\eqref{eq:S_first_deformation} therefore reduces to
\begin{equation}
	\dot{x}_{S,1}(t)=\hbar\,\rho_{S,0}(t).
	\label{eq:S_first_derivative}
\end{equation}
Integrating \eqref{eq:S_first_derivative} over $[0,t]$ gives
\begin{equation}
	x_{S,1}(t)-x_{S,1}(0)=\hbar\int_0^t\rho_{S,0}(\tau)\,d\tau.
	\label{eq:S_first_integral}
\end{equation}
The initial condition $\phi_S(0;q)=S(0)$ for all $q$ implies $x_{S,m}(0)=0$ for every $m\geq1$. Hence, equation~\eqref{eq:S_first_integral} becomes
\begin{equation}
	x_{S,1}(t)=\hbar\int_0^t\rho_{S,0}(\tau)\,d\tau,
	\label{eq:S_first_correction}
\end{equation}
where
\begin{equation}
	\rho_{S,0}(\tau)=-\Lambda-\delta R(0)+\bigl(\beta_1u_1(\tau)+\mu\bigr)S(0).
	\label{eq:S_zero_residual}
\end{equation}

For $m\geq2$, the deformation equation takes the for( \ref{eq:S_first_deformation bf}) written as 
\begin{equation}
	\dot{x}_{S,m}(t)-\dot{x}_{S,m-1}(t)=\hbar\,\rho_{S,m-1}(t).
	\label{eq:S_higher_deformation}
\end{equation}
Integrating \eqref{eq:S_higher_deformation} over $[0,t]$ w.r.t yields
\begin{equation}
	\begin{aligned}
		x_{S,m}(t)-x_{S,m}(0)
		&-x_{S,m-1}(t)+x_{S,m-1}(0)\\
		&=\hbar\int_0^t\rho_{S,m-1}(\tau)\,d\tau.
	\end{aligned}
	\label{eq:S_higher_integral}
\end{equation}
Since $m\geq2$, both correction terms have zero initial values by the initial-condition result above. Thus,
\begin{equation}
	x_{S,m}(t)=x_{S,m-1}(t)+\hbar\int_0^t\rho_{S,m-1}(\tau)\,d\tau,
	\quad m\geq2.
	\label{eq:S_higher_correction}
\end{equation}

Equations~\eqref{eq:S_first_correction} and~\eqref{eq:S_higher_correction} differ only in the presence of the preceding correction $x_{S,m-1}(t)$. To combine them, define the indicator coefficient
\begin{equation}
	\chi_m=
	\begin{cases}
		0, & m=1,\\
		1, & m\geq2.
	\end{cases}
	\label{eq:S_indicator}
\end{equation}
The unified recurrence is then
\begin{equation}
	x_{S,m}(t)=\chi_m\,x_{S,m-1}(t)+\hbar\int_0^t\rho_{S,m-1}(\tau)\,d\tau,
	\quad m\geq1.
	\label{eq:S_unified_recurrence}
\end{equation}
For $m=1$, $\chi_1=0$, and equation~\eqref{eq:S_unified_recurrence} reduces to equation~\eqref{eq:S_first_correction}. For $m\geq2$, $\chi_m=1$, and it reduces to equation~\eqref{eq:S_higher_correction}. Thus, $\chi_m$ is not a new solution term; it is an indicator that switches the preceding correction on or off. The residual $\rho_{S,m-1}$ is evaluated using the preceding-order components, including $x_{S,m-1}$ and $x_{R,m-1}$.

\medskip
\noindent\textbf{Series substitution for $E(t)$.}
The compartment $E(t)$ in System~\eqref{eq:model1} is replaced by its full power series,
\begin{equation}
	E(t)\;\to\;\sum_{k=0}^{\infty}x_{E,k}(t)q^k,
\end{equation}
and since $E$ is fed by $S$, the series $S(t)\to\sum_{k=0}^{\infty}x_{S,k}(t)q^k$ is used as well. The control $u_1$ and the parameters carry no $q$.

Recall
\begin{equation}
	N_E = \dot E-\beta_1u_1S+(\beta_2+\mu)E.
\end{equation}

Each term of $N_E$ is replaced one at a time.

\begin{equation}
	\dot E \;\to\; \sum_{k=0}^{\infty}\dot{x}_{E,k}(t)q^k.
\end{equation}

\begin{equation}
	\beta_1u_1S \;\to\; \sum_{k=0}^{\infty}\beta_1u_1\,x_{S,k}(t)q^k.
\end{equation}

\begin{equation}
	(\beta_2+\mu)E \;\to\; \sum_{k=0}^{\infty}(\beta_2+\mu)\,x_{E,k}(t)q^k.
\end{equation}

No term of $N_E$ is a constant without a state attached, so no indicator $\mathbf{1}_{\{k=0\}}$ is needed.

Adding the three replaced terms together, $N_E$ becomes one single sum over $k$:
\begin{equation}
	N_E \;\to\; \sum_{k=0}^{\infty}
	\Bigl[\dot{x}_{E,k}(t) - \beta_1u_1\,x_{S,k}(t) + (\beta_2+\mu)x_{E,k}(t)\Bigr]q^k.
\end{equation}

The bracket above is given a short name, $\rho_{E,k}(t)$:
\begin{equation}
	\rho_{E,k}(t) = \dot{x}_{E,k}(t) - \beta_1u_1\,x_{S,k}(t) + (\beta_2+\mu)x_{E,k}(t).
\end{equation}

So
\begin{equation}
	N_E[\boldsymbol{\phi}(t;q)]=\sum_{k=0}^{\infty}\rho_{E,k}(t)q^k .
\end{equation}

Multiplying both sides by $q\hbar$:
\begin{equation}
	q\hbar N_E[\boldsymbol{\phi}(t;q)]
	=\hbar\sum_{k=0}^{\infty}\rho_{E,k}(t)q^{k+1}.
\end{equation}

Set $m=k+1$, so $k=m-1$. As $k$ goes from $0$ to $\infty$, $m$ goes from $1$ to $\infty$:
\begin{equation}
	q\hbar N_E[\boldsymbol{\phi}(t;q)]
	=\hbar\sum_{m=1}^{\infty}\rho_{E,m-1}(t)q^m.
\end{equation}

This is the right-hand side of equation~\eqref{eq:zeroth2}, and it has the same form as the left-hand side~\eqref{eq:LHSexp}. Matching the coefficients of $q^m$ for $m\geq1$ gives
\begin{equation}
	\dot{x}_{E,m}(t)-\dot{x}_{E,m-1}(t)=\hbar\rho_{E,m-1}(t).
\end{equation}

\textbf{At $m=1$.}
\begin{equation}
	\dot{x}_{E,1}(t)-\dot{x}_{E,0}(t)=\hbar\rho_{E,0}(t).
\end{equation}
Since $x_{E,0}(t)=E(0)$ does not change with $t$, $\dot{x}_{E,0}(t)=0$. So
\begin{equation}
	\dot{x}_{E,1}(t)=\hbar\rho_{E,0}(t).
\end{equation}
Integrating both sides from $0$ to $t$:
\begin{equation}
	x_{E,1}(t)-x_{E,1}(0)=\hbar\int_0^t\rho_{E,0}(\tau)\,d\tau.
\end{equation}
The condition $\phi_E(0;q)=E(0)$ must hold for every value of $q$, so every correction term is zero at $t=0$ and $x_{E,1}(0)=0$. Hence
\begin{equation}
	x_{E,1}(t)=\hbar\int_0^t\rho_{E,0}(\tau)\,d\tau,
\end{equation}
where
\begin{equation}
	\rho_{E,0}(\tau)=-\beta_1u_1(\tau)S(0)+(\beta_2+\mu)E(0).
\end{equation}

\textbf{At $m\geq2$.} The same integration is repeated:
