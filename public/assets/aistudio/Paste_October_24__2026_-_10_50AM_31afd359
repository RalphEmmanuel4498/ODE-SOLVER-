\end{equation}
and since $A$ is fed by $E$, the series $E(t)\to\sum_{k=0}^{\infty}x_{E,k}(t)q^k$ is used as well. The control $u_2$ and the parameters carry no $q$.

Recall
\begin{equation}
	N_A = \dot A-\beta_2E+(\beta_3u_2+\alpha+\mu)A.
\end{equation}

Each term of $N_A$ is replaced one at a time.

\begin{equation}
	\dot A \;\to\; \sum_{k=0}^{\infty}\dot{x}_{A,k}(t)q^k.
\end{equation}

\begin{equation}
	\beta_2E \;\to\; \sum_{k=0}^{\infty}\beta_2\,x_{E,k}(t)q^k.
\end{equation}

\begin{equation}
	(\beta_3u_2+\alpha+\mu)A \;\to\; \sum_{k=0}^{\infty}(\beta_3u_2+\alpha+\mu)\,x_{A,k}(t)q^k.
\end{equation}

No constant source appears in $N_A$, so no indicator $\mathbf{1}_{\{k=0\}}$ is needed.

Adding the three replaced terms together, $N_A$ becomes one single sum over $k$:
\begin{equation}
	N_A \;\to\; \sum_{k=0}^{\infty}
	\Bigl[\dot{x}_{A,k}(t) - \beta_2\,x_{E,k}(t) + (\beta_3u_2+\alpha+\mu)x_{A,k}(t)\Bigr]q^k.
\end{equation}

The bracket above is given a short name, $\rho_{A,k}(t)$:
\begin{equation}
	\rho_{A,k}(t) = \dot{x}_{A,k}(t) - \beta_2\,x_{E,k}(t) + (\beta_3u_2+\alpha+\mu)x_{A,k}(t).
\end{equation}

