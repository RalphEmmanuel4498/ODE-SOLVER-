\begin{equation}
	q\hbar N_A[\boldsymbol{\phi}(t;q)]
	=\hbar\sum_{k=0}^{\infty}\rho_{A,k}(t)q^{k+1}.
\end{equation}

Set $m=k+1$, so $k=m-1$. As $k$ goes from $0$ to $\infty$, $m$ goes from $1$ to $\infty$:
\begin{equation}
	q\hbar N_A[\boldsymbol{\phi}(t;q)]
	=\hbar\sum_{m=1}^{\infty}\rho_{A,m-1}(t)q^m.
\end{equation}

This is the right-hand side of equation~\eqref{eq:zeroth2}, and it has the same form as the left-hand side~\eqref{eq:LHSexp}. Matching the coefficients of $q^m$ for $m\geq1$ gives
\begin{equation}
	\dot{x}_{A,m}(t)-\dot{x}_{A,m-1}(t)=\hbar\rho_{A,m-1}(t).
\end{equation}

\textbf{At $m=1$.}
\begin{equation}
	\dot{x}_{A,1}(t)-\dot{x}_{A,0}(t)=\hbar\rho_{A,0}(t).
\end{equation}
Since $x_{A,0}(t)=A(0)$ does not change with $t$, $\dot{x}_{A,0}(t)=0$. So
\begin{equation}
	\dot{x}_{A,1}(t)=\hbar\rho_{A,0}(t).
\end{equation}
