\begin{equation}
	\left.\begin{aligned}
		\dfrac{dS}{dt} &= \Lambda + \delta\,R(t)
		- \bigl(\beta_1 u_1(t)+\mu\bigr)S(t)\\[8pt]
		\dfrac{dE}{dt} &= \beta_1 u_1(t)\,S(t)
		- \bigl(\beta_2+\mu\bigr)E(t)\\[8pt]
		\dfrac{dA}{dt} &= \beta_2\,E(t)
		- \bigl(\beta_3 u_2(t)+\alpha+\mu\bigr)A(t)\\[8pt]
		\dfrac{dC}{dt} &= \bigl(\beta_3 u_2(t)+\alpha\bigr)A(t)
		- \bigl(\beta_4+\gamma+\mu\bigr)C(t)\\[8pt]
		\dfrac{dL}{dt} &= \beta_4\,C(t) - \mu\,L(t)\\[8pt]
		\dfrac{dR}{dt} &= \gamma\,C(t)
		- \bigl(\delta+\mu\bigr)R(t)
	\end{aligned}\right\}
	\label{eq:model1}
\end{equation}

\noindent subject to the initial conditions:
\begin{equation}
	S(0)=S_0>0,\quad E(0)\geq 0,\quad A(0)\geq 0,\quad
	C(0)=0,\quad L(0)=0,\quad R(0)=0.
	\label{eq:ic1}
\end{equation}

System~\eqref{eq:model1} and Figure~\ref{fig:model1} correspond: each arrow is a term, all inflows and outflows accounted for. $S(t)$ receives recruitment $\Lambda$ and re-entry $\delta R$, loses to exposure and exit. $A(t)$ has three outflows: retargeting $\beta_3 u_2 A$, organic $\alpha A$, exit $\mu A$. $C(t)$ splits between loyalty $\beta_4$ and churn $\gamma$.

