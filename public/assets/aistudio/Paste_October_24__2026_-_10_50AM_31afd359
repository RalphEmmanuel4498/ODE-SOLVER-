\begin{theorem}[Convergence of the HAM Series]
	\label{thm:HAM_convergence}
	Let $\hbar=-1$ in the recurrence~\eqref{eq:recursion}. Then, for every $T>0$, the series $\sum_{m=0}^{\infty}\mathbf{x}_m(t)$ of equation~\eqref{eq:Maclaurin} at $q=1$ converges on $[0,T]$ to the unique solution of System~\eqref{eq:model1}--\eqref{eq:ic1}.
\end{theorem}

\begin{proof}
	System~\eqref{eq:model1} is written as
	$\dot{\mathbf{x}}=\mathcal{F}(t,\mathbf{x})=J(t)\mathbf{x}+\mathbf{b}$,
	where $J(t)$ and $\mathbf{b}$ are as in Table~\ref{tab:conv_notation}.
	Integrating both sides from $0$ to $t$ gives
	\begin{equation}
		\int_0^t\dot{\mathbf{x}}(\tau)\,d\tau
		=\int_0^t\mathcal{F}\bigl(\tau,\mathbf{x}(\tau)\bigr)\,d\tau.
	\end{equation}
	Using the initial condition, this becomes
	\begin{equation}
		\mathbf{x}(t)=\mathbf{x}(0)
		+\int_0^t\mathcal{F}\bigl(\tau,\mathbf{x}(\tau)\bigr)\,d\tau.
		\label{eq:integralform}
	\end{equation}
	
	Let $\mathbf{\Phi}_M(t)$ denote the sum of the first $M+1$ terms of the HAM series,
	\begin{equation}
		\mathbf{\Phi}_M(t)=\mathbf{x}_0(t)+\mathbf{x}_1(t)+\cdots+\mathbf{x}_M(t),
	\end{equation}
	where $\mathbf{\Phi}_0(t)=\mathbf{x}_0(t)=\mathbf{x}(0)$.
	
	From equation~\eqref{eq:recursion},
	$\mathbf{x}_1(t)=\hbar\int_0^t\boldsymbol{\rho}_0(\tau)\,d\tau$,
	where $\boldsymbol{\rho}_0=\dot{\mathbf{x}}_0-J\mathbf{x}_0-\mathbf{b}$
	and $\dot{\mathbf{x}}_0=\mathbf{0}$. Hence,
	$\boldsymbol{\rho}_0=-J\mathbf{x}_0-\mathbf{b}$, and setting $\hbar=-1$ gives
	\begin{equation}
		\mathbf{x}_1(t)
		=-\int_0^t\boldsymbol{\rho}_0(\tau)\,d\tau
		=\int_0^t\bigl[J(\tau)\mathbf{x}_0+\mathbf{b}\bigr]d\tau.
	\end{equation}
	Since $\mathcal{F}(\tau,\mathbf{y})=J(\tau)\mathbf{y}+\mathbf{b}$
	and $\mathbf{x}_0=\mathbf{\Phi}_0$, we obtain
	\begin{equation}
		\mathbf{x}_1(t)
		=\int_0^t\mathcal{F}\bigl(\tau,\mathbf{\Phi}_0(\tau)\bigr)\,d\tau.
		\label{eq:x1form}
	\end{equation}
	
	For $m\geq2$, equation~\eqref{eq:recursion} gives
	\begin{equation}
		\mathbf{x}_m(t)
		=\mathbf{x}_{m-1}(t)
		-\int_0^t\bigl[\dot{\mathbf{x}}_{m-1}(\tau)
		-J(\tau)\mathbf{x}_{m-1}(\tau)\bigr]d\tau.
	\end{equation}
	Separating the integrals and applying the fundamental theorem of calculus yields
	\begin{equation}
		\mathbf{x}_m(t)
		=\mathbf{x}_{m-1}(0)
		+\int_0^tJ(\tau)\mathbf{x}_{m-1}(\tau)\,d\tau.
	\end{equation}
	The recurrence~\eqref{eq:recursion} gives
	$\mathbf{x}_{m-1}(0)=\mathbf{0}$ for $m\geq2$. Therefore,
	\begin{equation}
		\mathbf{x}_m(t)
		=\int_0^tJ(\tau)\mathbf{x}_{m-1}(\tau)\,d\tau.
		\label{eq:xm_interim}
	\end{equation}
	
	By the definition of $\mathbf{\Phi}_M$,
	$\mathbf{x}_{m-1}=\mathbf{\Phi}_{m-1}-\mathbf{\Phi}_{m-2}$
	for $m\geq2$. Substitution into equation~\eqref{eq:xm_interim} gives
	\begin{equation}
		\mathbf{x}_m(t)
		=\int_0^tJ(\tau)
		\bigl[\mathbf{\Phi}_{m-1}(\tau)-\mathbf{\Phi}_{m-2}(\tau)\bigr]d\tau.
	\end{equation}
	Adding and subtracting $\mathbf{b}$ inside the integrand and using the definition of $\mathcal{F}$, we obtain
	\begin{equation}
		\mathbf{x}_m(t)
		=\int_0^t\Bigl[
		\mathcal{F}\bigl(\tau,\mathbf{\Phi}_{m-1}(\tau)\bigr)
		-\mathcal{F}\bigl(\tau,\mathbf{\Phi}_{m-2}(\tau)\bigr)
		\Bigr]d\tau,\qquad m\geq2.
		\label{eq:xmform}
	\end{equation}
	
	Using equations~\eqref{eq:x1form} and~\eqref{eq:xmform}, the partial sum
	$\mathbf{\Phi}_M=\sum_{m=0}^{M}\mathbf{x}_m$ can be written as
	\begin{align}
		\mathbf{\Phi}_M(t)
		&=\mathbf{x}(0)
		+\int_0^t\mathcal{F}\bigl(\tau,\mathbf{\Phi}_0(\tau)\bigr)d\tau
		\nonumber\\
		&\quad+\sum_{m=2}^{M}\int_0^t
		\Bigl[
		\mathcal{F}\bigl(\tau,\mathbf{\Phi}_{m-1}(\tau)\bigr)
		-\mathcal{F}\bigl(\tau,\mathbf{\Phi}_{m-2}(\tau)\bigr)
		\Bigr]d\tau.
	\end{align}
	The integrals cancel consecutively, leaving
	\begin{equation}
		\mathbf{\Phi}_M(t)
		=\mathbf{x}(0)
		+\int_0^t\mathcal{F}\bigl(\tau,\mathbf{\Phi}_{M-1}(\tau)\bigr)\,d\tau,
		\qquad M\geq1.
		\label{eq:HAM_picard}
	\end{equation}
	
	Equation~\eqref{eq:HAM_picard} is the Picard iteration associated with the integral equation~\eqref{eq:integralform}. Since $\mathcal{F}(t,\mathbf{x})=J(t)\mathbf{x}+\mathbf{b}$ is linear in $\mathbf{x}$ and $J(t)$ is bounded on every finite interval $[0,T]$, the Picard iterates converge uniformly on $[0,T]$ to the unique solution of System~\eqref{eq:model1}--\eqref{eq:ic1} \citep{coddington1955}. Consequently,
	$\mathbf{\Phi}_M(t)\to\mathbf{x}(t)$ uniformly on $[0,T]$ as $M\to\infty$. Thus, the HAM series at $q=1$ converges to the stated solution.
\end{proof}



\begin{remark}
	The Homotopy Perturbation Method (HPM) is the recurrence~\eqref{eq:recursion} with $\hbar=-1$ fixed, so HPM is HAM at one value of $\hbar$. For the present affine model, $\hbar=-1$ already converges, so HAM and HPM give the same series. HAM is retained because the freedom in $\hbar$ becomes necessary when later models are nonlinear.
\end{remark}

