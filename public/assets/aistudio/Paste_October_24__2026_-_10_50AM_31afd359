\begin{equation}
	x_{A,1}(t)-x_{A,1}(0)=\hbar\int_0^t\rho_{A,0}(\tau)\,d\tau.
\end{equation}
The condition $\phi_A(0;q)=A(0)$ must hold for every value of $q$, so $x_{A,1}(0)=0$. Hence
\begin{equation}
	x_{A,1}(t)=\hbar\int_0^t\rho_{A,0}(\tau)\,d\tau,
\end{equation}
where
\begin{equation}
	\rho_{A,0}(\tau)=-\beta_2E(0)+(\beta_3u_2(\tau)+\alpha+\mu)A(0).
\end{equation}

\textbf{At $m\geq2$.} The same integration is repeated:
\begin{equation}
