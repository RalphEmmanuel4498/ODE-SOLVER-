\medskip
\noindent\textbf{Recurrence solution.}
The six residuals are
\begin{align}
	\rho_{S,k} &=
	\dot{x}_{S,k}-\Lambda\,\mathbf{1}_{\{k=0\}}
	-\delta x_{R,k}
	+(\beta_1u_1+\mu)x_{S,k}, \nonumber\\
	\rho_{E,k} &=
	\dot{x}_{E,k}-\beta_1u_1x_{S,k}
	+(\beta_2+\mu)x_{E,k}, \nonumber\\
	\rho_{A,k} &=
	\dot{x}_{A,k}-\beta_2x_{E,k}
	+(\beta_3u_2+\alpha+\mu)x_{A,k}, \nonumber\\
	\rho_{C,k} &=
	\dot{x}_{C,k}-(\beta_3u_2+\alpha)x_{A,k}
	+(\beta_4+\gamma+\mu)x_{C,k}, \nonumber\\
	\rho_{L,k} &=
	\dot{x}_{L,k}-\beta_4x_{C,k}+\mu x_{L,k}, \nonumber\\
	\rho_{R,k} &=
	\dot{x}_{R,k}-\gamma x_{C,k}
	+(\delta+\mu)x_{R,k}.
	\label{eq:rhodefs}
\end{align}
For all six compartments $i\in\{S,E,A,C,L,R\}$, the recurrence is
\begin{equation}
	x_{i,m}(t)
	=\chi_m\,x_{i,m-1}(t)
	+\hbar\int_0^t\rho_{i,m-1}(\tau)\,d\tau,
	\quad m\geq1,
	\label{eq:recursion}
\end{equation}
with $x_{i,0}(t)=x_i(0)$, $\chi_1=0$ and $\chi_m=1$ for $m\geq2$.

Thus, the residuals recover the total-population balance
$\dot{N}=\Lambda-\mu N$ order by order.

\noindent\textbf{Note.} The residual $\rho_{i,m-1}$ is the error left in compartment $i$ after the corrections up to order $m-1$ are substituted. It drives each new correction and carries no $\hbar$ of its own, since $\hbar$ only multiplies it in~\eqref{eq:recursion}.


\subsubsection{Convergence of the HAM Series}
\label{sec:convergence}

This subsection proves that the HAM series converges for $\hbar=-1$, by showing that its partial sums are the Picard iterates of the system.

In addition to the HAM symbols of Table~\ref{tab:ham_notation}, the convergence proof uses the quantities listed in Table~\ref{tab:conv_notation}. They are introduced to write the system in vector form and to compare the HAM partial sums with the Picard iteration.

\begin{longtable}{@{}p{2.8cm}p{10.4cm}@{}}
	\caption{Additional notation used in the convergence proof}
	\label{tab:conv_notation}\\
	\toprule
	\textbf{Symbol} & \textbf{Description} \\
	\midrule
	\endfirsthead
	\multicolumn{2}{l}{\small\textit{Table~\ref{tab:conv_notation} continued}}\\
	\toprule
